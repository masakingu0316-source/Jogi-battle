{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jogi-battle",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // 画面（HTML/JS/CSS）は public/ から配信する
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 1部屋＝1つの Durable Object（無料プランは SQLite 版のみ使える）
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // ---- ログイン機能（README の「ログイン機能を有効にする」を済ませてから、下の2つの // を外す） ----
  // アカウントを保存するデータベース。database_id は Cloudflare で作ったデータベースのID
  "d1_databases": [{ "binding": "DB", "database_name": "jogi-battle-db", "database_id": "0131ea0c-5fd7-4e34-a00e-9a963ab5ca32" }],
  // Google の OAuth クライアントID（公開しても問題ない値）。シークレットはダッシュボードで設定する
  "vars": { "GOOGLE_CLIENT_ID": "106830932727-hl9bvcb2ulte5d55618b422o2tg8qs2q.apps.googleusercontent.com" },

  "observability": { "enabled": true }
}
